{
	"name": "veld",
	"version": "0.1.4",
	"description": "Static, dependency-free API documentation driven by a single JSON file.",
	"type": "module",
	"bin": {
		"veld": "bin/veld.mjs"
	},
	"files": [
		"src",
		"bin",
		"examples/minimal",
		"examples/blog",
		"examples/ecommerce",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=18"
	},
	"keywords": [
		"api",
		"documentation",
		"static",
		"rest",
		"openapi-alternative",
		"json-driven",
		"docs",
		"zero-dependency"
	],
	"author": "Lauwed",
	"license": "MIT",
	"homepage": "https://github.com/usher-2002/tabula-docs-to_make",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/usher-2002/tabula-docs-to_make.git"
	},
	"bugs": {
		"url": "https://github.com/usher-2002/tabula-docs-to_make/issues"
	},
	"scripts": {
		"prepare": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit && cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push",
		"test": "node --test test/validate.test.mjs test/src.test.mjs test/pretty-json.test.mjs test/endpoints.test.mjs",
		"validate:examples": "for f in examples/*/api.json; do node bin/validate-api.mjs \"$f\"; done",
		"fmt": "prettier --write \"package.json\" \"src/index.html\" \"src/assets/**/*.{js,css}\""
	},
	"devDependencies": {
		"prettier": "^3.9.9"
	}
}
